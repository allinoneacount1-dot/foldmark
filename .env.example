# FOLDMARK — environment
#
# Copy to .env.local for local development. .env* is gitignored; never commit a
# filled-in copy, and never move a value here to a NEXT_PUBLIC_ name — anything
# prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is public.

# ---------------------------------------------------------------- database
# Postgres. Neon's free tier is what FOLDMARK is built against; any Postgres 15+
# works. Use the POOLED connection string for the app — Vercel functions are
# frozen between requests and a direct connection per invocation exhausts a free
# tier's connection ceiling quickly.
#
#   https://neon.tech -> project -> Connection string -> Pooled connection
#
# Server-only. The browser never connects to the database; it calls the FOLDMARK
# API, which queries server-side.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/foldmark?sslmode=require

# Optional. Some operations (a long migration, a bulk import) are better on a
# direct connection than through the pooler. Only set this if you need it.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/foldmark?sslmode=require

# ------------------------------------------------------------------ chain
# Robinhood Chain, id 4663. Public node, no key. The client fails over across a
# comma-separated list, so a dead endpoint degrades instead of breaking.
NEXT_PUBLIC_ROBINHOOD_RPC=https://robinhood-rpc.publicnode.com
# FOLDMARK_RPC_URLS=https://robinhood-rpc.publicnode.com,https://another-node

# ------------------------------------------------------ persistent runner
# Used by scripts/live-indexer.mjs only. The free public node retains roughly 52
# blocks of logs — about five seconds at this chain's block time — so ingestion
# follows the head over a WebSocket rather than polling and catching up.
# FOLDMARK_WS_URL=wss://robinhood-rpc.publicnode.com
# FOLDMARK_BASE_URL=https://your-deployment.vercel.app

# Optional. When set, the ingestion route requires `Authorization: Bearer <it>`.
# Leave unset and the route is open; set it on any deployment reachable publicly.
# Never pass this as a command-line argument — it ends up in shell history and
# in the scheduled-task definition. Set it in the user environment.
# CRON_SECRET=

# --------------------------------------------------------------- providers
# DEX Screener is probed as supporting this chain and is OFF by default. Their
# terms restrict redistribution and products competing with their screener,
# which is a decision about the business rather than the chain. Opt in per
# deployment, after reading them.
DEXSCREENER_ENABLED=false

# GeckoTerminal is the active free market source. Attribution is required and is
# rendered in the interface.
# GECKOTERMINAL_ENABLED=true
